<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Mr Goose backend: local ASP.NET Core sidecar (REST + SignalR), launched by the Electron shell.
       Holds the brains, the SQLite/EF Core store, import and the OpenRouter client (later phases).
       P0: /health + an AgentHub handshake only. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MrGoose.Backend</RootNamespace>
    <AssemblyName>MrGoose.Backend</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- agent knowledge base: ship the .md docs next to the exe -->
    <Content Include="knowledge\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Override the vulnerable transitive e_sqlite3 2.1.11 (NU1903 / CVE-2025-6965, SQLite < 3.50.2)
         pulled in by EF Core 10 — 2.1.12 bundles the patched SQLite. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- DPAPI: encrypt OpenRouter keys at rest (Windows CurrentUser). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
